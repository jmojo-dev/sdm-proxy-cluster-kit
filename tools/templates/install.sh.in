#!/usr/bin/env bash
# StrongDM Proxy Cluster Kit @@KIT_VERSION@@ - bootstrap installer (@@KIT_BUILD@@)
# GENERATED by tools/build.sh from tools/templates/install.sh.in - do not edit.
# Download the release asset to a private directory and verify the published attestation:
#   gh release verify-asset TAG ./install.sh --repo OWNER/REPO
# After successful verification, run: sudo bash ./install.sh
# For automation, supply only the specific variables needed by the selected mode.
#
# shellcheck disable=SC2174  # -m on the deepest dir only is intended

sdmkit_payload() {
  cat <<'@@DELIM@@'
@@PAYLOAD@@
@@DELIM@@
}

SDMKIT_SHA256=@@KIT_SHA256@@

sdmkit_fail() { # CODE "WHAT" "FIX"
  printf '\n+---- ERROR (sdm-proxy-cluster-kit bootstrap) ----\n| WHAT: %s\n' "$2" >&2
  printf '| FIX:  %s\n' "$3" >&2
  printf '+------------------------------------------------\n' >&2
  exit "$1"
}

sdmkit_sha256() { # FILE -> hex digest on stdout
  local out
  if command -v sha256sum >/dev/null 2>&1; then out=$(sha256sum "$1") || return 1
  else out=$(shasum -a 256 "$1") || return 1; fi
  printf '%s' "${out%% *}"
}

sdmkit_tty() { # true when a usable terminal exists and automation did not opt out
  [ "${KIT_NONINTERACTIVE:-}" != 1 ] && { : </dev/tty; } 2>/dev/null
}

# Runs as root: directly, or inside `sudo bash -c` (shipped there with declare -f).
sdmkit_install_and_run() { # SRC SHA256 [kit args...]
  local src=$1 want=$2 dir=/opt/sdm-proxy-cluster-kit got tmp dst
  shift 2
  dst="$dir/sdm-proxy-cluster-kit.sh"
  umask 077
  [ -d /opt ] || mkdir -m 0755 /opt || exit 1
  [ ! -L /opt ] && [ "$(stat -c %u /opt)" = 0 ] && [ -z "$(find /opt -maxdepth 0 -perm /022 -print)" ] || exit 1
  [ -d "$dir" ] || mkdir -m 0700 "$dir" || exit 1
  [ ! -L "$dir" ] && [ "$(stat -c %u:%a "$dir")" = 0:700 ] || sdmkit_fail 1 "Unsafe kit directory" "Check ownership and permissions of $dir."
  tmp=$(mktemp "$dir/.install.XXXXXX") || exit 1
  if [ "$src" = embedded ]; then sdmkit_payload > "$tmp" || exit 1
  else cat -- "$src" > "$tmp" || exit 1; fi
  got=$(sdmkit_sha256 "$tmp")
  if [ "$got" != "$want" ]; then
    rm -f "$tmp"; sdmkit_fail 1 "the embedded kit failed its SHA-256 check" "verify the release asset and try again"
  fi
  chmod 0700 "$tmp" && mv -fT "$tmp" "$dst" || exit 1
  printf 'sdm-proxy-cluster-kit: saved %s (sha256 %.12s...)\n' "$dst" "$want" >&2
  if sdmkit_tty; then
    exec bash "$dst" "$@" </dev/tty
  fi
  exec bash "$dst" "$@" </dev/null
}

sdmkit_main() {
  local tmp rc
  if [ -z "${BASH_VERSION:-}" ]; then
    sdmkit_fail 2 "this installer needs bash" "verify the downloaded release and run sudo bash ./install.sh"
  fi
  if [ "$(id -u)" = 0 ]; then
    sdmkit_install_and_run embedded "$SDMKIT_SHA256" "$@"
  fi
  # Not root. The script arrived on a pipe, so it cannot re-read itself: write the
  # kit to a private temp file and hand that to a root shell through sudo.
  if ! command -v sudo >/dev/null 2>&1; then
    sdmkit_fail 3 "this needs root and sudo is not installed" \
      "verify install.sh, then run it in a root shell"
  fi
  if ! sdmkit_tty; then
    sdmkit_fail 3 "this needs root, and there is no terminal for a sudo password prompt" \
      "verify the downloaded release and run sudo bash ./install.sh"
  fi
  tmp=$(umask 077; mktemp "${TMPDIR:-/tmp}/sdm-proxy-cluster-kit.XXXXXX") \
    || sdmkit_fail 1 "mktemp failed" "check that ${TMPDIR:-/tmp} is writable"
  sdmkit_payload > "$tmp" || sdmkit_fail 1 "could not write $tmp" "check free space: df -h ${TMPDIR:-/tmp}"
  printf 'sdm-proxy-cluster-kit: not root, re-running the install step with sudo.\n' >&2
  printf 'sdm-proxy-cluster-kit: note: sudo drops your environment (KIT_*, SDM_*).\n' >&2
  sudo bash -c "$(declare -f sdmkit_fail sdmkit_sha256 sdmkit_tty sdmkit_install_and_run)
sdmkit_install_and_run \"\$@\"" sdmkit "$tmp" "$SDMKIT_SHA256" "$@" </dev/tty
  rc=$?; rm -f -- "$tmp"; return "$rc"
}

sdmkit_main "$@"
